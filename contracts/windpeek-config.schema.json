{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://windpeek.app/contracts/windpeek-config.schema.json",
  "title": "Windpeek installed configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "boardId",
    "deviceTimezone",
    "spot",
    "forecastModel",
    "display",
    "digest"
  ],
  "properties": {
    "version": {
      "enum": [
        5,
        6
      ]
    },
    "boardId": {
      "enum": [
        "seeedstudio_reterminal_e1001",
        "seeedstudio_reterminal_e1002",
        "seeedstudio_reterminal_e1003"
      ]
    },
    "deviceTimezone": {
      "type": "string",
      "minLength": 3,
      "maxLength": 63
    },
    "spot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "latitude",
        "longitude",
        "timezone"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "timezone": {
          "type": "string",
          "minLength": 3,
          "maxLength": 63
        }
      }
    },
    "forecastModel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 31
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "showThreshold",
        "threshold",
        "showWeather",
        "showTemperature",
        "showTide",
        "timeFormat",
        "temperatureUnit",
        "showDedicatedFooter",
        "windSize",
        "swellSize",
        "swellModel",
        "moduleOrder"
      ],
      "properties": {
        "showThreshold": {
          "type": "boolean"
        },
        "threshold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "showWeather": {
          "type": "boolean"
        },
        "showTemperature": {
          "type": "boolean"
        },
        "showTide": {
          "type": "boolean"
        },
        "timeFormat": {
          "enum": [
            "24-hour",
            "12-hour"
          ]
        },
        "temperatureUnit": {
          "enum": [
            "celsius",
            "fahrenheit"
          ]
        },
        "showDedicatedFooter": {
          "type": "boolean"
        },
        "windSize": {
          "enum": [
            "off",
            "small",
            "large"
          ]
        },
        "swellSize": {
          "enum": [
            "off",
            "small",
            "large"
          ]
        },
        "swellModel": {
          "enum": [
            "best_match",
            "meteofrance_wave",
            "ncep_gfswave025",
            "dwd_ewam"
          ]
        },
        "moduleOrder": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "wind",
              "swell",
              "weather",
              "temperature",
              "tide"
            ]
          }
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "additionalSpots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "items": {
        "allOf": [
          {
            "$ref": "#"
          },
          {
            "properties": {
              "version": {
                "const": 5
              }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "version": {
            "const": 6
          }
        }
      },
      "then": {
        "required": [
          "additionalSpots"
        ],
        "properties": {
          "boardId": {
            "const": "seeedstudio_reterminal_e1003"
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "additionalSpots"
          ]
        }
      }
    }
  ]
}
